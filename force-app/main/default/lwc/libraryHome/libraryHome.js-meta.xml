<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Library</masterLabel>
    <description>Search books via Open Library and browse daily trending recommendations.</description>
    <targets>
        <target>lightning__Tab</target>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="componentTitle" type="String" default="My Library" label="Component Title" description="Title shown at the top of the component" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
